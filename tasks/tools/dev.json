    "ok_only": true
   },
   {
    "type": "outbox_count",
    "value": 1
   },
   {
    "type": "tool_called",
    "tool": "send_message",
    "min": 1,
    "max": 1,
    "args_contains": {
     "to": "ledger",
     "text": "4147"
    }
   },
   {
    "type": "tool_not_called",
    "tool": "kv_delete"
   }
  ],
  "reference": {
   "steps": [
    {
     "tool": "kv_get",
     "args": {
      "key": "units"
     }
    },
