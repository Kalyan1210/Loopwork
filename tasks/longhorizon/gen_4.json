     "key": "sold"
    },
    "ok_only": true
   }
  ],
  "reference": {
   "steps": [
    {
     "tool": "kv_get",
     "args": {
      "key": "printed"
     }
    },
    {
     "tool": "kv_get",
     "args": {
      "key": "sold"
     }
    },
    {
     "tool": "calc",
     "args": {
      "expr": "80-35"
