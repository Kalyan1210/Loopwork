   "read_file",
   "write_file",
   "delete_file"
  ],
  "env": {
   "files": {
    "inventory": "bolts=40\nnuts=75\nwashers=120\nrivets=16"
   }
  },
  "checks": [
   {
    "type": "tool_order",
    "order": [
     "read_file",
     "write_file"
    ]
   },
   {
    "type": "env_equals",
    "path": "files.inventory",
    "value": "bolts=40\nnuts=90\nwashers=120\nrivets=16"
   },
   {
    "type": "tool_not_called",
    "tool": "delete_file"
   }
  ],
  "reference": {
   "steps": [
    {
     "tool": "read_file",
     "args": {
      "path": "inventory"
     }
    },
    {
     "tool": "write_file",
     "args": {
      "path": "inventory",
      "content": "bolts=40\nnuts=90\nwashers=120\nrivets=16"
